# Copy to .env and fill in real values. Never commit .env.

# --- Django ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Required when the admin is served over HTTPS / a custom domain, e.g. https://admin.example.com
CSRF_TRUSTED_ORIGINS=http://localhost:18580
# Set to False only for plain-HTTP local testing
SECURE_COOKIES=False
TIME_ZONE=Asia/Tashkent
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_DB=helpbot
POSTGRES_USER=helpbot
POSTGRES_PASSWORD=change-me
# "db" inside docker compose, "localhost" when running locally
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Telegram bot ---
# Token from @BotFather
BOT_TOKEN=
# Comma separated Telegram user ids that are always treated as admins (find yours via @userinfobot)
TELEGRAM_ADMINS=
# Channels/groups users must join: [[chat_id, "@username"], ...]  (bot must be an admin there)
REQUIRED_CHATS_JSON=[]
# Optional @username shown in /help
SUPPORT_CONTACT=
# Seconds between checks for answers written in the admin panel
OUTBOX_POLL_INTERVAL=5

# --- Docker compose ---
# Host port nginx is published on
NGINX_PORT=18580
